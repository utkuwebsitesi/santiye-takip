APP_NAME="Şantiye Takip"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kasa.example.com
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=santiye_kasa
DB_USERNAME=santiye_kasa
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=15
SESSION_IDLE_TIMEOUT=15
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14
MYSQLDUMP_PATH=mysqldump

ADMIN_NAME="Sistem Yöneticisi"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

SYSTEM_ADMIN_NAME="Sistem Sahibi"
SYSTEM_ADMIN_USERNAME=system
SYSTEM_ADMIN_PASSWORD=

DOCUMENT_MAX_KB=5120
